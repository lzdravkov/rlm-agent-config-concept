<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <!--
                SAME bindings as spikeConfigApply so this drops into
                RenderDraw_Product_Configurator_Flow the same way. Both ids arrive
                from Flow variables; no @api outputs are needed because all state is
                persisted in the org and re-read on apply.
            -->
            <property name="quoteId" type="String" label="Quote Id"
                      description="Id of the parent Quote (required by the save/reprice engine)."/>
            <property name="quoteLineItemId" type="String" label="Quote Line Item Id"
                      description="Id of the root configurable QuoteLineItem being configured."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
