<?xml version="1.0" encoding="UTF-8"?>
<!--
  Named Credential: RevenueAgent_AgentAPI
  Endpoint for the Agentforce Agent API. Agent invocation calls go to the
  Salesforce API platform host (api.salesforce.com), while the token is minted
  at the org's My Domain (configured on the linked External Credential).

  Apex callout usage:
      HttpRequest req = new HttpRequest();
      req.setEndpoint('callout:RevenueAgent_AgentAPI/einstein/ai-agent/v1/agents/'
                      + '0Xxg8000001B9dhCAC/sessions');   // create session
      req.setMethod('POST');
      // Authorization header is injected automatically by the Named Credential.

  generateAuthorizationHeader=true lets the platform inject the Bearer token.
-->
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Revenue Agent - Agent API</label>
    <namedCredentialType>SecuredEndpoint</namedCredentialType>
    <namedCredentialParameters>
        <parameterName>Url</parameterName>
        <parameterType>Url</parameterType>
        <parameterValue>https://api.salesforce.com</parameterValue>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <parameterName>ExternalCredential</parameterName>
        <parameterType>Authentication</parameterType>
        <parameterValue>RevenueAgent_AgentAPI</parameterValue>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <parameterName>GenerateAuthorizationHeader</parameterName>
        <parameterType>GenerateAuthorizationHeader</parameterType>
        <parameterValue>true</parameterValue>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <parameterName>AllowMergeFieldsInBody</parameterName>
        <parameterType>AllowMergeFieldsInBody</parameterType>
        <parameterValue>false</parameterValue>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <parameterName>AllowMergeFieldsInHeader</parameterName>
        <parameterType>AllowMergeFieldsInHeader</parameterType>
        <parameterValue>false</parameterValue>
    </namedCredentialParameters>
</NamedCredential>
