<?xml version="1.0" encoding="UTF-8"?>
<!--
  External Credential: RevenueAgent_AgentAPI
  OAuth 2.0 Client Credentials auth for server-to-server calls to the Agentforce
  Agent API. Consumer key/secret come from ECA "RevenueAgent_Headless".

  Schema modeled on this org's existing External Credentials (v67 grammar):
  parameterType uses the AuthProtocolVariant / AuthParameter / NamedPrincipal enums.

  SECURITY & UI FINISH: For OAuth client_credentials, the token endpoint, consumer
  key, consumer secret, and scopes are entered on the PRINCIPAL in the UI (secret is
  stored encrypted, non-retrievable). This file establishes the protocol + principal
  so the Named Credential can bind to it:
      Setup -> Named Credentials -> External Credentials -> Revenue Agent - Agent API
        -> Principals -> edit "AgentAPIPrincipal" -> Authentication Parameters:
             Token Endpoint: https://trailsignup-e01123b28c25c6.my.salesforce.com/services/oauth2/token
             Client ID:      3MVG94bpcMC_ekBhFUPCR9xAffeHjrv8CtzCqd39WO1vGcsx6gc8HygvfzPWDicH.u5VoFa9QllWj62Ck2cYb
             Client Secret:  <paste from ECA — entered here, NOT in source>
             Scope:          chatbot_api api sfap_api
      Then click "Authenticate".
  A permission set must grant the running user access to this principal
  (RevenueAgent_AgentAPI_Access — built next).
-->
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Oauth</authenticationProtocol>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>ClientCredentials</parameterName>
        <parameterType>AuthProtocolVariant</parameterType>
        <parameterValue>ClientCredentials</parameterValue>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>AgentAPIPrincipal</parameterGroup>
        <parameterName>AgentAPIPrincipal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>Revenue Agent - Agent API</label>
</ExternalCredential>
