<?xml version="1.0" encoding="UTF-8"?>
<!--
  Global OAuth settings for RevenueAgent_Headless.
  Confidential client (server-to-server), so:
    - PKCE not required (PKCE is for public clients: SPA/mobile).
    - Consumer secret is NOT optional (confidential client must present a secret).
  Callback URL is required by the metadata even for Client Credentials; a
  localhost HTTPS placeholder is used since no interactive redirect occurs in
  the Client Credentials flow. Adjust in the UI if you also enable Auth Code.
-->
<ExtlClntAppGlobalOauthSettings xmlns="http://soap.sforce.com/2006/04/metadata">
    <callbackUrl>https://login.salesforce.com/services/oauth2/callback</callbackUrl>
    <externalClientApplication>RevenueAgent_Headless</externalClientApplication>
    <isConsumerSecretOptional>false</isConsumerSecretOptional>
    <isIntrospectAllTokens>false</isIntrospectAllTokens>
    <isPkceRequired>false</isPkceRequired>
    <isSecretRequiredForRefreshToken>false</isSecretRequiredForRefreshToken>
    <label>Revenue Agent Headless</label>
    <shouldRotateConsumerKey>false</shouldRotateConsumerKey>
    <shouldRotateConsumerSecret>false</shouldRotateConsumerSecret>
</ExtlClntAppGlobalOauthSettings>
